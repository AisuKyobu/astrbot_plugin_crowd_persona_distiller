# Normalize line endings to LF for cross-platform consistency.
# Python and JS files should always be LF regardless of Windows checkout.
* text=auto eol=lf

*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.html text eol=lf
